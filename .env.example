# Copier en .env.local et compléter. Ne jamais versionner .env.local.

# Projet Supabase (Paramètres > API). En local, `npx supabase status` affiche ces valeurs.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Adresse publique du site (liens des e-mails de connexion).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé secrète : uniquement pour les scripts lancés sur votre machine
# (import du contenu, ajout d'un administrateur). Jamais dans l'hébergement du site.
SUPABASE_SECRET_KEY=
