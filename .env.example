# Copier en .env.local et compléter. Ne jamais versionner .env.local.

# Projet Supabase (Paramètres > API). En local, `npx supabase status` affiche ces valeurs.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Adresse publique du site (liens des e-mails de connexion, retour après paiement).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Clés secrètes : côté serveur uniquement, jamais avec le préfixe NEXT_PUBLIC_ ---

# Clé secrète Supabase : scripts (import du contenu, administrateurs) et serveur du site
# (confirmation des paiements, lecture des cours en PDF originaux).
SUPABASE_SECRET_KEY=

# Stripe (Développeurs > Clés API) : clé de test « sk_test_… » en local.
STRIPE_SECRET_KEY=
# Secret de signature du webhook ; en local, celui qu'affiche `stripe listen`.
STRIPE_WEBHOOK_SECRET=
